# --- Database (Supabase) ---
# Use the transaction pooler connection string (port 6543) for the app and worker.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Direct connection (port 5432), used only by migrations.
DATABASE_URL_DIRECT=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# --- Meta / WhatsApp Cloud API ---
# Use the version shown in App Dashboard > WhatsApp > API Setup.
GRAPH_API_VERSION=v24.0
# App Dashboard > App settings > Basic. Used to verify webhook signatures.
META_APP_SECRET=
# Any random string; paste the same value in the webhook configuration.
META_WEBHOOK_VERIFY_TOKEN=
# Temporary token during development; a system user token in production.
META_ACCESS_TOKEN=

# Phone number that sends notifications to sellers and managers (the tool's own number).
# During development, the Cloud API test number works here.
TOOL_PHONE_NUMBER_ID=

# System user token (agency Business Manager) with leads_retrieval on the
# client pages it manages. Leave empty until Lead Ads is set up.
META_LEADS_ACCESS_TOKEN=

# --- Worker ---
WORKER_POLL_INTERVAL_MS=2000
